{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "treino",
  "main": "./server.js",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./Public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/auth/*",
      "/shape-together-api/*"
    ]
  },
  "vars": {
    "SUPABASE_URL": "https://tlrxwhezvbzdbxoviohb.supabase.co",
    "COOKIE_SECURE": "true",
    "APP_ORIGIN": "https://treino.dheisson-sousa.workers.dev"
  }
}
